generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  username       String    @unique
  phoneNumber    String?   @unique
  hashedPassword String?
  displayName    String
  avatarUrl      String?
  bio            String?   @db.Text
  status         String?
  lastSeen       DateTime  @default(now())
  
  // Статус онлайн
  isOnline       Boolean   @default(false)
  lastActive     DateTime  @default(now())
  
  // FCM push token для мобильных уведомлений
  fcmToken       String?
  
  settings       UserSettings?

  // Отношения
  chats          Chat[]    @relation("UserChats")
  messages       Message[]
  chatMembers    ChatMember[]
  readReceipts   ReadReceipt[]
  callsCreated   Call[]    @relation("CallsCreated")
  
  ownedServers   Server[]  @relation("ServerOwner")
  memberServers  Server[]  @relation("ServerMembers")
  
  // Инвайты, созданные пользователем
  createdInvites Invite[]  @relation("InviteCreator")

  // Стикеры — паки, созданные пользователем + избранные
  stickerPacks      StickerPack[]         @relation("StickerPackAuthor")
  favoriteStickers  StickerPackFavorite[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  
  // 🔐 Приватность
  showOnlineStatus    Boolean  @default(true)
  showLastSeen        Boolean  @default(true)
  allowDirectMessages String   @default("everyone") // "everyone" | "contacts" | "nobody"
  allowAddToChats     String   @default("everyone")
  profileVisibility   String   @default("public")   // "public" | "contacts" | "private"
  
  // 🎨 Внешний вид
  theme               String   @default("system")   // "light" | "dark" | "system"
  chatTheme           String?
  messageFontSize     String   @default("medium")   // "small" | "medium" | "large"
  accentColor         String?
  chatBackground      String?
  
  // 🔔 Уведомления
  pushNotifications   Boolean  @default(true)
  soundNotifications  Boolean  @default(true)
  vibration           Boolean  @default(true)
  showNotificationPreview Boolean @default(true)
  mutedChats          String[]
  
  // 💬 Поведение чата
  sendReadReceipts    Boolean  @default(true)
  showTypingIndicator Boolean  @default(true)
  autoDownloadMedia   String   @default("wifi")     // "always" | "wifi" | "never"
  compressImages      Boolean  @default(true)
  
  // ⚙️ Гибкие предпочтения
  preferences         Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

enum ChatType {
  PRIVATE
  GROUP
  CHANNEL
}

enum AccessType {
  PUBLIC    
  LINK_ONLY 
  PRIVATE   
}

enum ChatRole {
  CREATOR
  ADMIN
  MEMBER
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

model Server {
  id          String     @id @default(cuid())
  name        String
  imageUrl    String?
  inviteCode  String     @unique @default(uuid())
  access      AccessType @default(PUBLIC)
  
  ownerId     String
  owner       User       @relation("ServerOwner", fields: [ownerId], references: [id])
  
  chats       Chat[]
  members     User[]     @relation("ServerMembers")
  
  // Инвайты для сервера (теперь связь правильная)
  invites     Invite[]   @relation("ServerInvites")

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Chat {
  id          String     @id @default(cuid())
  name        String?
  imageUrl    String?
  type        ChatType
  access      AccessType @default(PUBLIC)
  inviteCode  String?    @unique @default(uuid())

  serverId    String?
  server      Server?    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  users       User[]     @relation("UserChats")
  members     ChatMember[]
  messages    Message[]
  readReceipts ReadReceipt[]
  calls       Call[]
  
  // Инвайты для чата
  invites     Invite[]   @relation("ChatInvites")

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt @default(now())
}

model Call {
  id           String     @id @default(cuid())
  chatId       String
  chat         Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)

  createdById  String
  createdBy    User       @relation("CallsCreated", fields: [createdById], references: [id], onDelete: Cascade)

  type         CallType
  status       CallStatus @default(RINGING)

  // Stream Call identifier (e.g. "messanger:call_...")
  streamCallId String     @unique

  // SDP offer for WebRTC (хранится, чтобы получатель мог получить его при опоздании)
  offerSdp    String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([chatId])
  @@index([createdById])
  @@index([status])
}

model ChatMember {
  id        String   @id @default(cuid())
  role      ChatRole @default(MEMBER)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chatId])
}

model Block {
  id          String   @id @default(cuid())
  blockerId   String
  blockedId   String
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model ChatUserPreference {
  id         String   @id @default(cuid())
  userId     String
  chatId     String
  isPinned   Boolean  @default(false)
  isArchived Boolean  @default(false)
  isMuted    Boolean  @default(false)
  pinnedAt   DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, chatId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  fileUrl   String?
  fileName  String?
  fileType  String?
  reactions Json?
  forwardedFromMessageId String?
  forwardedFromChatId    String?
  forwardedFromChatName  String?
  forwardedFromChatType  ChatType?
  forwardedFromUserId    String?
  forwardedFromUserName  String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  replyToId   String?
  replyTo     Message? @relation("MessageReply", fields: [replyToId], references: [id])
  replies     Message[] @relation("MessageReply")

  readReceipts ReadReceipt[]

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([chatId])
  @@index([userId])
}

// 🆕 Модель для инвайтов/приглашений
model Invite {
  id          String     @id @default(cuid())
  code        String     @unique
  chatId      String?
  chat        Chat?      @relation("ChatInvites", fields: [chatId], references: [id], onDelete: Cascade)
  
  serverId    String?
  server      Server?    @relation("ServerInvites", fields: [serverId], references: [id], onDelete: Cascade)
  
  createdBy   String
  creator     User       @relation("InviteCreator", fields: [createdBy], references: [id])
  
  maxUses     Int?       // Максимальное количество использований (null = безлимит)
  uses        Int        @default(0) // Текущее количество использований
  expiresAt   DateTime?  // Дата истечения (null = никогда)
  
  isActive    Boolean    @default(true) // Активен ли инвайт
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([code])
  @@index([chatId])
  @@index([serverId])
  @@index([createdBy])
}


// ─── Стикеры ─────────────────────────────────────────────────────────────────

model StickerPack {
  id          String   @id @default(cuid())
  name        String              // "Котики на районе"
  slug        String   @unique    // "cats-by-vadim-abc123"
  description String?  @db.Text
  coverUrl    String?             // обложка для grid'а паков
  isPublic    Boolean  @default(true)

  authorId    String
  author      User     @relation("StickerPackAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  stickers    Sticker[]
  favorites   StickerPackFavorite[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([isPublic])
}

model Sticker {
  id        String   @id @default(cuid())
  imageUrl  String              // PNG/WEBP с прозрачным фоном
  alt       String?             // эмодзи-подсказка ("🐱"), max ~6 символов
  position  Int      @default(0)

  packId    String
  pack      StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([packId])
}

model StickerPackFavorite {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  packId    String
  pack      StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())

  @@id([userId, packId])
  @@index([userId])
  @@index([packId])
}
